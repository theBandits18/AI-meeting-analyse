  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "node ./node_modules/vite/bin/vite.js",
    "dev:server": "node ./server/index.mjs",
